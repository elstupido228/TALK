# Образец. Настоящие значения — только в ~/talk-proto/.env на сервере (chmod 600).
DOMAIN=talk.perveev.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_DAILY_LIMIT=50
# необязательно (значения по умолчанию):
# OPENAI_MAX_IMAGES=8          страниц в одном вызове модели
# OPENAI_REASONING_EFFORT=     low | medium | high — только для моделей с рассуждением
# OPENAI_TIMEOUT_MS=180000
# EXTRACT_MAX_MB=20
# EXTRACT_MAX_PAGES=20

DADATA_TOKEN=
PARSERAPI_KEY=

# ИНН компаний для демо «Проверка по ИНН» через запятую (не в репозитории); прогрев кэша: scripts/warm-demo-cache.js
DEMO_INNS=
# Режим коннектора: CONNECTOR_<ID>_MODE=sandbox (id: cbr, dadata, fin, kontur, spark, onec, crm)
