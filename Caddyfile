# Сертификат Let's Encrypt выпускается автоматически (порты 80/443 открыты).
(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# Прототип не индексируется поисковиками
	header X-Robots-Tag "noindex, nofollow"

	request_body {
		max_size 25MB
	}
}

{$DOMAIN} {
	import common
	reverse_proxy app:3000
}

# Тестовый стенд: тот же код, своя база с условными данными
{$STAGING_DOMAIN} {
	import common
	reverse_proxy staging:3000
}
