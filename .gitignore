# --- Секреты: никогда в репозиторий ---
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
users.txt
users*.csv
passwords*.txt
secrets/

# --- Данные и базы (SQLite живёт в томе Docker) ---
/data/
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-journal
*.db-wal
*.db-shm

# --- Документы: реальные PDF/выгрузки клиентов не коммитим ---
# Условные PDF генерируются скриптом и тоже не хранятся.
*.pdf
*.xlsx
*.xls
*.docx
!seed/calc/template_clean.xlsx
# условные PDF для замера распознавания (вымышленные компании)
!bench/pdf/**/*.pdf

# --- Производные артефакты seed (пересоздаются скриптами) ---
# Данные раннего предупреждения в git не кладём: только карты (обучены на условных и открытых данных).
# demo.json пересоздаётся gen_data.py (детерминированно) при сборке образа, пул и срезы — командами из seed/ews/README.md.
seed/ews/data/*
!seed/ews/data/model.json
!seed/ews/data/model_5_признаков_2026-10-14.json
seed/ews_open/data/*
!seed/ews_open/data/model_open.json
seed/ews_open/data_mock/
seed/ews/*.html
!seed/ews/page_src.html
seed/calc/in/
seed/calc/js.json

# --- Сборка и зависимости ---
node_modules/
dist/
build/
coverage/
.cache/
__pycache__/
*.py[cod]
.venv/
venv/

# --- Журналы и временное ---
logs/
*.log
tmp/
.tmp/

# --- Окружение разработчика ---
.claude/settings.local.json
.vscode/
.idea/
.DS_Store
Thumbs.db
